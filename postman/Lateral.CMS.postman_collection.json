{
  "info": {
    "name": "Lateral CMS",
    "description": "Exercises the whole service: the CMS webhook, the consumer API, the admin override, and the authentication and authorization boundaries between the three accounts.\n\nThe folders are ordered so that **Run collection** works end to end: the ingestion folder creates entities with identifiers unique to the run, the later folders read and override them. Every request asserts its expected status, so a run either passes or points at what broke.\n\nBase URL and credentials come from collection variables and match `appsettings.json` out of the box. Change `baseUrl` if the API is not on <http://localhost:49699>.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:49699",
      "type": "string"
    },
    {
      "key": "orgUser",
      "value": "cms-webhook-client",
      "type": "string"
    },
    {
      "key": "orgPassword",
      "value": "fd23cb16-5bd5-4334-9115-b9a0ebde5a3d",
      "type": "string"
    },
    {
      "key": "consumerUser",
      "value": "content-consumer-1",
      "type": "string"
    },
    {
      "key": "consumerPassword",
      "value": "ec12ccd4-e9dc-4cb3-bae6-e5f08a7a8359",
      "type": "string"
    },
    {
      "key": "adminUser",
      "value": "content-admin-root",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "226b714d-e4bf-4656-859b-67c0950e23ff",
      "type": "string"
    },
    {
      "key": "invalidPassword",
      "value": "not-the-password",
      "type": "string"
    },
    {
      "key": "publishedId",
      "value": "",
      "type": "string"
    },
    {
      "key": "unpublishedId",
      "value": "",
      "type": "string"
    },
    {
      "key": "deletedId",
      "value": "",
      "type": "string"
    },
