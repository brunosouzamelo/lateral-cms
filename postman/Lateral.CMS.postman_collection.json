    },
    {
      "name": "1. Ingestion (Organization)",
      "description": "The webhook, as the CMS calls it. Only the `Organization` account may post here.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{orgUser}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{orgPassword}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Publish a batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"type\": \"publish\",\n    \"id\": \"{{publishedId}}\",\n    \"version\": 2,\n    \"payload\": { \"title\": \"A published entity\", \"tags\": [\"demo\"] },\n    \"timestamp\": \"{{eventTimestamp}}\"\n  },\n  {\n    \"type\": \"unPublish\",\n    \"id\": \"{{unpublishedId}}\",\n    \"version\": 4,\n    \"payload\": { \"title\": \"An unpublished entity\" },\n    \"timestamp\": \"{{eventTimestamp}}\"\n  },\n  {\n    \"type\": \"publish\",\n    \"id\": \"{{deletedId}}\",\n    \"version\": 1,\n    \"payload\": { \"title\": \"About to be deleted\" },\n    \"timestamp\": \"{{eventTimestamp}}\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cms/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms",
                "events"
              ]
            },
            "description": "One batch with all three event types. The identifiers are generated per run, so the collection can be run repeatedly against the same database.\n\nThe answer is `202`, not `200`: the batch is stored and applied afterwards by the background processor."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Identifiers unique to this run, so a re-run does not collide with the previous one.",
                  "const stamp = Date.now();",
                  "",
                  "pm.collectionVariables.set('publishedId', `pm-${stamp}-published`);",
                  "pm.collectionVariables.set('unpublishedId', `pm-${stamp}-unpublished`);",
                  "pm.collectionVariables.set('deletedId', `pm-${stamp}-deleted`);",
                  "",
                  "// Slightly in the past: an event timestamp may not be further ahead than the allowed clock skew.",
                  "pm.collectionVariables.set('eventTimestamp', new Date(stamp - 60000).toISOString());",
                  "pm.collectionVariables.set('deleteTimestamp', new Date(stamp - 30000).toISOString());",
                  "",
                  "// The CMS's own trace for this delivery. The service stores it against every event of the batch",
                  "// and echoes it back, so one delivery can be followed across both systems.",
                  "pm.collectionVariables.set('correlationId', `cms-trace-${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "",
                  "const receipt = pm.response.json();",
                  "",
                  "pm.test('every event was accepted', () => {",
                  "    pm.expect(receipt.received).to.eql(3);",
                  "    pm.expect(receipt.accepted).to.eql(3);",
                  "    pm.expect(receipt.rejected).to.eql(0);",
                  "});",
                  "",
                  "pm.test('the receipt identifies the batch', () => pm.expect(receipt.batchId).to.be.a('string'));",
                  "",
                  "pm.collectionVariables.set('batchId', receipt.batchId);",
                  "",
                  "pm.test('the correlation identifier is echoed back', () =>",
                  "    pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.collectionVariables.get('correlationId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete an entity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"type\": \"delete\",\n    \"id\": \"{{deletedId}}\",\n    \"timestamp\": \"{{deleteTimestamp}}\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cms/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms",
                "events"
              ]
            },
            "description": "A delete carries no version and no payload. It hard-deletes the entity and leaves a tombstone, so an event still in flight for it cannot bring it back."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('accepted', () => pm.expect(pm.response.json().accepted).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Batch with an invalid event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"type\": \"publish\",\n    \"id\": \"{{publishedId}}-extra\",\n    \"version\": 1,\n    \"payload\": { \"title\": \"This one is fine\" },\n    \"timestamp\": \"{{eventTimestamp}}\"\n  },\n  {\n    \"type\": \"publish\",\n    \"id\": \"missing-version\",\n    \"payload\": { \"title\": \"No version\" },\n    \"timestamp\": \"{{eventTimestamp}}\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cms/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms",
                "events"
              ]
            },
            "description": "Each event is validated on its own. The invalid one is reported in the receipt by its index in the batch and the valid one is still accepted, so a single malformed event does not cost the CMS the whole delivery."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "",
                  "const receipt = pm.response.json();",
                  "",
                  "pm.test('the valid event is kept, the invalid one is reported', () => {",
                  "    pm.expect(receipt.accepted).to.eql(1);",
                  "    pm.expect(receipt.rejected).to.eql(1);",
                  "});",
                  "",
                  "pm.test('the rejection points at the offending event', () => {",
                  "    const rejection = receipt.rejections[0];",
                  "",
                  "    pm.expect(rejection.index).to.eql(1);",
                  "    pm.expect(rejection.id).to.eql('missing-version');",
                  "    pm.expect(rejection.errors.join(' ')).to.include(\"'version'\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Empty batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cms/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms",
                "events"
              ]
            },
            "description": "The batch itself is unusable, so nothing is stored and the answer is a `400` with problem details."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('answers problem details', () => pm.expect(pm.response.json()).to.have.property('errors'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Re-deliver the first batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"type\": \"publish\",\n    \"id\": \"{{publishedId}}\",\n    \"version\": 2,\n    \"payload\": { \"title\": \"A published entity\", \"tags\": [\"demo\"] },\n    \"timestamp\": \"{{eventTimestamp}}\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cms/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms",
                "events"
              ]
            },
            "description": "Webhook delivery is at-least-once, so the same event arrives twice after a timeout. It is accepted again — the inbox records every delivery — but applying it changes nothing: the event log shows it as `Ignored`.\n\nSee **Event log for the published entity** in the admin folder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('the re-delivery is taken in', () => pm.expect(pm.response.json().accepted).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Entities as a consumer (User)",
      "description": "What an ordinary consumer sees: entities published in the CMS that no administrator has disabled.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{consumerUser}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{consumerPassword}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List entities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities?pageIndex=0&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities"
              ],
              "query": [
                {
                  "key": "pageIndex",
                  "value": "0"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "sortColumn",
                  "value": "LastEventTimestamp",
                  "disabled": true
                },
                {
                  "key": "sortDirection",
                  "value": "DESC",
                  "disabled": true
                },
                {
                  "key": "id",
                  "value": "pm-",
                  "disabled": true
                }
              ]
            },
            "description": "Paged listing. `pageSize` is capped at 100; the answer is `{ pageIndex, total, hasNextPage, list }`.\n\nThe disabled query parameters show the other options: sorting and filtering by identifier prefix."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The webhook acknowledges before the events are applied, so give the background",
                  "// processor a moment before reading the result of the batch above.",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const page = pm.response.json();",
                  "",
                  "pm.test('answers the paging envelope', () => {",
                  "    pm.expect(page).to.have.property('pageIndex');",
                  "    pm.expect(page).to.have.property('total');",
                  "    pm.expect(page).to.have.property('hasNextPage');",
                  "    pm.expect(page.list).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('only published, enabled entities are listed', () =>",
                  "    page.list.forEach(entity => {",
                  "        pm.expect(entity.status).to.eql('Published');",
                  "        pm.expect(entity.isDisabledByAdmin).to.be.false;",
                  "    }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the published entity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{publishedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{publishedId}}"
              ]
            },
            "description": "The payload is returned as JSON, not as an escaped string, so a consumer does not have to parse it twice.\n\n`version` is the latest data the service holds; `lastPublishedVersion` is the last one that arrived through a publish."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const entity = pm.response.json();",
                  "",
                  "pm.test('it is the entity the batch published', () => {",
                  "    pm.expect(entity.id).to.eql(pm.collectionVariables.get('publishedId'));",
                  "    pm.expect(entity.version).to.eql(2);",
                  "    pm.expect(entity.lastPublishedVersion).to.eql(2);",
                  "    pm.expect(entity.status).to.eql('Published');",
                  "});",
                  "",
                  "pm.test('the payload comes back as JSON', () => {",
                  "    pm.expect(entity.payload).to.be.an('object');",
                  "    pm.expect(entity.payload.title).to.eql('A published entity');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the unpublished entity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{unpublishedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{unpublishedId}}"
              ]
            },
            "description": "Unpublishing in the CMS keeps the entity in the persistence layer but hides it from consumers.\n\nThe answer is `404`, exactly like an entity that does not exist, so this endpoint cannot be used to discover the identifiers of hidden entities. An administrator can still read it — see the admin folder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404: hidden and non-existent answer the same way', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the deleted entity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{deletedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{deletedId}}"
              ]
            },
            "description": "A delete is a hard delete: the row is gone, and no account can read it back."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Entities as an administrator (Admin)",
      "description": "An administrator sees everything a consumer sees plus the entities unpublished in the CMS and those disabled locally, and is the only account that may disable one.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{adminUser}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{adminPassword}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get the unpublished entity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{unpublishedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{unpublishedId}}"
              ]
            },
            "description": "The same route the consumer got a `404` from. No separate endpoint: what changes is what the query returns.\n\nNote `lastPublishedVersion` is `null` — this entity reached the service through an unPublish and was never published, so its data is version 4 but no version of it was ever public."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const entity = pm.response.json();",
                  "",
                  "pm.test('the data is kept even though it is not public', () => {",
                  "    pm.expect(entity.status).to.eql('Unpublished');",
                  "    pm.expect(entity.version).to.eql(4);",
                  "    pm.expect(entity.lastPublishedVersion).to.eql(null);",
                  "    pm.expect(entity.payload.title).to.eql('An unpublished entity');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List unpublished entities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities?status=Unpublished&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Unpublished"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "isDisabledByAdmin",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": "`status` and `isDisabledByAdmin` are administrator-only filters. A consumer sending them is not refused — they are simply ignored, because they could not widen what a consumer is allowed to see."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('the filter is applied', () =>",
                  "    pm.response.json().list.forEach(entity => pm.expect(entity.status).to.eql('Unpublished')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable the published entity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDisabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{publishedId}}/disabled",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{publishedId}}",
                "disabled"
              ]
            },
            "description": "The only write the API allows. It is a local override: it hides the entity from consumers here and is never sent back to the CMS, whose data — payload, version, published status — stays untouched and cannot be changed through this API by anybody."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "The entity is hidden from consumers",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{consumerUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{consumerPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{publishedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{publishedId}}"
              ]
            },
            "description": "The same request that answered `200` in the consumer folder, sent again after the override."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 once disabled', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "The administrator still sees it",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{publishedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{publishedId}}"
              ]
            },
            "description": "The override is recorded in its own fields — `isDisabledByAdmin` and `disabledByAdminDate` — next to untouched CMS data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const entity = pm.response.json();",
                  "",
                  "pm.test('the override is recorded', () => {",
                  "    pm.expect(entity.isDisabledByAdmin).to.be.true;",
                  "    pm.expect(entity.disabledByAdminDate).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('the CMS data behind it is untouched', () => {",
                  "    pm.expect(entity.status).to.eql('Published');",
                  "    pm.expect(entity.version).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Re-enable the entity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDisabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{publishedId}}/disabled",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{publishedId}}",
                "disabled"
              ]
            },
            "description": "The override is reversible and leaves no trace on the CMS data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable an entity that is not stored",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDisabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities/{{deletedId}}/disabled",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities",
                "{{deletedId}}",
                "disabled"
              ]
            },
            "description": "The entity was hard-deleted by the CMS, and the override went with it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Event log for the published entity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cms/events?externalId={{publishedId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms",
                "events"
              ],
              "query": [
                {
                  "key": "externalId",
                  "value": "{{publishedId}}"
                },
                {
                  "key": "status",
                  "value": "Failed",
                  "disabled": true
                },
                {
                  "key": "batchId",
                  "value": "{{batchId}}",
                  "disabled": true
                }
              ]
            },
            "description": "The processing record of every event received, newest first, with the outcome and the reason for it. Payloads are never returned here.\n\nThe two rows for this entity are the original delivery (`Applied`) and the re-delivery (`Ignored`, as a duplicate) — which is what makes the webhook safe to retry.\n\nFilter by `status=Failed` to answer \"what did not get through, and why\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const statuses = pm.response.json().list.map(e => e.status);",
                  "",
                  "pm.test('the delivery was applied and the re-delivery ignored', () => {",
                  "    pm.expect(statuses).to.include('Applied');",
                  "    pm.expect(statuses).to.include('Ignored');",
                  "});",
                  "",
                  "pm.test('the payload is never exposed here', () =>",
                  "    pm.expect(pm.response.text()).to.not.include('A published entity'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Event log for one delivery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cms/events?correlationId={{correlationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms",
                "events"
              ],
              "query": [
                {
                  "key": "correlationId",
                  "value": "{{correlationId}}"
                }
              ]
            },
            "description": "The same log, filtered by the identifier the CMS sent on the delivery rather than by entity. This is what turns a trace in the CMS into the list of what this service did about it — without reading a single log line.\n\nThe first batch carried three events, so three rows come back, all with that identifier."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const rows = pm.response.json().list;",
                  "const expected = pm.collectionVariables.get('correlationId');",
                  "",
                  "pm.test('the whole delivery comes back', () => pm.expect(rows).to.have.lengthOf(3));",
                  "",
                  "pm.test('every row carries the identifier the CMS sent', () =>",
                  "    rows.forEach(row => pm.expect(row.correlationId).to.eql(expected)));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Authentication and authorization",
      "description": "Every entity is treated as confidential, so no route but the health probes is anonymous. These requests cover both halves: who gets in, and what each account is then allowed to do.",
      "item": [
        {
          "name": "No credentials",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities"
              ]
            },
            "description": "Authorization is closed by default: the fallback policy requires an authenticated user, so a route is private unless it opts out."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "",
                  "pm.test('challenges with the Basic scheme', () =>",
                  "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Basic realm='));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{consumerUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{invalidPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities"
              ]
            },
            "description": "Passwords are compared in constant time, and an unknown user still pays for a comparison, so neither the password nor the existence of a user can be inferred from how long the request takes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown user",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "someone-unknown",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{consumerPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities"
              ]
            },
            "description": "A valid password belonging to another account does not help: the pair has to match."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed Authorization header",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic not-base-64!!"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities"
              ]
            },
            "description": "A header that is not a decodable `user:password` pair is rejected before anything is looked up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "The CMS account cannot read content",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{orgUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{orgPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entities"
              ]
