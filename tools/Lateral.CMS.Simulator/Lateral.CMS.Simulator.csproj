<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Lateral.CMS.Simulator</RootNamespace>

		<Version>1.0.0</Version>
	</PropertyGroup>

	<!--
	  No reference to the service projects on purpose: the simulator stands in for the CMS, so it talks to
	  the webhook over HTTP with its own shapes. Sharing types would let a breaking change to the contract
	  pass unnoticed here.
	-->

</Project>
